# Copy this file to .env and fill in your Supabase project's public values.
# The anon key is safe for frontend use (protected by RLS) — never put the
# service_role key here; that belongs only in the backend simulator script.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
